# Backblaze B2 S3-compatible storage
# Create a non-master Backblaze application key for the bucket.
B2_ENDPOINT=https://s3.<your-region>.backblazeb2.com
B2_ACCESS_KEY_ID=<backblaze-application-key-id>
B2_SECRET_ACCESS_KEY=<backblaze-application-key>
B2_BUCKET=<backblaze-bucket-name>
B2_REGION=<your-region>

# Local fallback used when the B2 variables above are not configured.
RESUME_STORAGE_DIR=./private_uploads

# AI Hiring Studio provider (default remains OpenRouter)
AI_PROVIDER=openrouter

# OpenAI / ChatGPT API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# Claude / Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Cloudflare Workers AI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/qwen/qwen3.8-27b

# Local Ollama (backend must run on the same computer for localhost to work)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:4b
